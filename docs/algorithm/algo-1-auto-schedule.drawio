<mxfile host="Claude"><diagram id="algo-1-auto-schedule" name="ขั้นตอนการจัดตารางสอนอัตโนมัติ"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane0" value="ระบบ (งานเบื้องหลังผ่าน Celery)" style="swimlane;startSize=50;fillColor=none;swimlaneFillColor=none;fontStyle=1;fontSize=22;html=1;fontFamily=TH SarabunPSK;strokeColor=#000000;fontColor=#000000;fontSize=22;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="790" height="972" as="geometry"/></mxCell><mxCell id="s" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="382" y="67" width="26" height="26" as="geometry"/></mxCell><mxCell id="a1" value="ตรวจความพร้อม: ทุกห้องมีแผนการเรียน&lt;br&gt;ทุกวิชามีครูผู้สอน และคาบไม่เกินช่องเวลา" style="html=1;fontFamily=TH SarabunPSK;fontSize=20;strokeColor=#000000;fontColor=#000000;rounded=1;arcSize=30;whiteSpace=wrap;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="216" y="134" width="358" height="60" as="geometry"/></mxCell><mxCell id="d1" value="" style="html=1;fontFamily=TH SarabunPSK;fontSize=20;strokeColor=#000000;fontColor=#000000;rhombus;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="375" y="228" width="40" height="40" as="geometry"/></mxCell><mxCell id="x1" value="แจ้งรายการที่ต้องแก้ไข&lt;br&gt;ก่อนจัดอัตโนมัติ" style="html=1;fontFamily=TH SarabunPSK;fontSize=20;strokeColor=#000000;fontColor=#000000;rounded=1;arcSize=30;whiteSpace=wrap;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="510" y="218" width="210" height="60" as="geometry"/></mxCell><mxCell id="e1" value="" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="600" y="317" width="30" height="30" as="geometry"/></mxCell><mxCell id="a2" value="แตกภาระสอนของแต่ละห้องเป็นงานทีละคาบ&lt;br&gt;(เป็นคาบคู่ถ้ากำหนดให้เรียนติดกัน)" style="html=1;fontFamily=TH SarabunPSK;fontSize=20;strokeColor=#000000;fontColor=#000000;rounded=1;arcSize=30;whiteSpace=wrap;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="232" y="302" width="325" height="60" as="geometry"/></mxCell><mxCell id="a3" value="เรียงงานจากยากไปง่าย: คาบคู่ ห้องเฉพาะทาง&lt;br&gt;จำนวนครู และลำดับความสำคัญของวิชา" style="html=1;fontFamily=TH SarabunPSK;fontSize=20;strokeColor=#000000;fontColor=#000000;rounded=1;arcSize=30;whiteSpace=wrap;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="212" y="386" width="366" height="60" as="geometry"/></mxCell><mxCell id="m1" value="" style="html=1;fontFamily=TH SarabunPSK;fontSize=20;strokeColor=#000000;fontColor=#000000;rhombus;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="375" y="480" width="40" height="40" as="geometry"/></mxCell><mxCell id="d2" value="" style="html=1;fontFamily=TH SarabunPSK;fontSize=20;strokeColor=#000000;fontColor=#000000;rhombus;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="375" y="564" width="40" height="40" as="geometry"/></mxCell><mxCell id="a9" value="สรุปจำนวนคาบที่วางได้&lt;br&gt;และรายการที่วางไม่ได้" style="html=1;fontFamily=TH SarabunPSK;fontSize=20;strokeColor=#000000;fontColor=#000000;rounded=1;arcSize=30;whiteSpace=wrap;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="75" y="554" width="210" height="60" as="geometry"/></mxCell><mxCell id="e2" value="" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="165" y="653" width="30" height="30" as="geometry"/></mxCell><mxCell id="a4" value="หยิบงานถัดไป หาช่องเวลาและห้อง&lt;br&gt;ที่ผ่านเงื่อนไขบังคับ (Hard) ทุกข้อ" style="html=1;fontFamily=TH SarabunPSK;fontSize=20;strokeColor=#000000;fontColor=#000000;rounded=1;arcSize=30;whiteSpace=wrap;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="236" y="638" width="317" height="60" as="geometry"/></mxCell><mxCell id="d3" value="" style="html=1