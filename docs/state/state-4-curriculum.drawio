<mxfile host="Claude"><diagram id="state-4-curriculum" name="สถานะหลักสูตร"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="397" y="11" width="26" height="26" as="geometry"/></mxCell><mxCell id="dr" value="&lt;b style=&quot;font-size:21px&quot;&gt;ฉบับร่าง&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;draft · แก้ไขได้&lt;/span&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000;margin:4px -12px&quot;&gt;&lt;div style=&quot;text-align:left;font-size:18px&quot;&gt;กำหนดแผนการเรียนและรายวิชา (UC-3)&lt;br&gt;กำหนดครูผู้สอนของแต่ละรายวิชา (UC-3)&lt;br&gt;ลบหลักสูตรได้&lt;/div&gt;" style="html=1;fontFamily=TH SarabunPSK;strokeColor=#000000;fontColor=#000000;rounded=1;arcSize=12;whiteSpace=wrap;fillColor=#FFFFFF;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="230" y="110" width="360" height="135" as="geometry"/></mxCell><mxCell id="ac" value="&lt;b style=&quot;font-size:21px&quot;&gt;ใช้งานอยู่&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;active · แก้ไขได้&lt;/span&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000;margin:4px -12px&quot;&gt;&lt;div style=&quot;text-align:left;font-size:18px&quot;&gt;ใช้จัดตารางสอนตามแผนการเรียน (UC-4 ถึง 7)&lt;br&gt;ใช้ตรวจหน่วยกิตสะสมในรายงาน (UC-16)&lt;br&gt;ม.ต้น และ ม.ปลาย ใช้งานได้ระดับละ 1 หลักสูตร&lt;/div&gt;" style="html=1;fontFamily=TH SarabunPSK;strokeColor=#000000;fontColor=#000000;rounded=1;arcSize=12;whiteSpace=wrap;fillColor=#FFFFFF;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="230" y="345" width="360" height="135" as="geometry"/></mxCell><mxCell id="ia" value="&lt;b style=&quot;font-size:21px&quot;&gt;ปิดใช้งาน&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;inactive · อ่านอย่างเดียว&lt;/span&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000;margin:4px -12px&quot;&gt;&lt;div style=&quot;text-align:left;font-size:18px&quot;&gt;ดูย้อนหลังได้&lt;br&gt;ผลการเรียนเก่ายังอ้างถึงรายวิชาในหลักสูตรนี้&lt;/div&gt;" style="html=1;fontFamily=TH SarabunPSK;strokeColor=#000000;fontColor=#000000;rounded=1;arcSize=12;whiteSpace=wrap;fillColor=#FFFFFF;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="230" y="580" width="360" height="114" as="geometry"/></mxCell><mxCell id="f" value="" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="715" y="162" width="30" height="30" as="geometry"/></mxCell><mxCell id="e0" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s" target="dr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l0" value="ครูฝ่ายวิชาการสร้างใหม่&lt;br&gt;หรือคัดลอกจากหลักสูตรเดิม (UC-3)" style="text;html=1;fontFamily=TH SarabunPSK;fontSize=18;fontColor=#000000;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="416" y="44" width="212" height="48" as="geometry"/></mxCell><mxCell id="e1" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dr" target="ac"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l1" value="ประกาศใช้ (UC-3)&lt;br&gt;/ ปิดหลักสูตรเดิมระดับเดียวกัน" style="text;html=1;fontFamily=TH SarabunPSK;fontSize=18;fontColor=#000000;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="416" y="263" width="182" height="48" as="geometry"/></mxCell><mxCell id="e2" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ac" target="ia"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l2" value="มีหลักสูตรใหม่ระดับเดียวกัน&lt;br&gt;ประกาศใช้แทน (UC-3)" style="text;html=1;fontFamily=TH SarabunPSK;fontSize=18;fontColor=#000000;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="416" y="498" width="159" height="48" as="geometry"/></mxCell><mxCell id="e3" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dr" target="f"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l3" value="ลบ" style="text;html=1;fontFamily=TH SarabunPSK;fontSize=18;fontColor=#000000;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="640" y="154" width="23" height="27" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>