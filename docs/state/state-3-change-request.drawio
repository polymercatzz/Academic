<mxfile host="Claude"><diagram id="state-3-change-request" name="สถานะคำร้องขอเปลี่ยนการจัดตารางสอน"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="397" y="11" width="26" height="26" as="geometry"/></mxCell><mxCell id="pe" value="&lt;b style=&quot;font-size:21px&quot;&gt;รออนุมัติ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;pending&lt;/span&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000;margin:4px -12px&quot;&gt;&lt;div style=&quot;text-align:left;font-size:18px&quot;&gt;ครูฝ่ายวิชาการดูตารางก่อนและหลังการเปลี่ยน (UC-21)&lt;br&gt;ระบบตรวจการชนของเป้าหมายก่อนอนุมัติ&lt;br&gt;ยื่นคำร้องใหม่ของคาบเดียวกันไม่ได้จนกว่าคำร้องนี้จะสิ้นสุด&lt;/div&gt;" style="html=1;fontFamily=TH SarabunPSK;strokeColor=#000000;fontColor=#000000;rounded=1;arcSize=12;whiteSpace=wrap;fillColor=#FFFFFF;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="80" width="640" height="135" as="geometry"/></mxCell><mxCell id="ap" value="&lt;b style=&quot;font-size:21px&quot;&gt;อนุมัติ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;approved&lt;/span&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000;margin:4px -12px&quot;&gt;&lt;div style=&quot;text-align:left;font-size:18px&quot;&gt;สร้างฉบับเผยแพร่ใหม่&lt;br&gt;ฉบับเดิมเป็นฉบับเก่า&lt;/div&gt;" style="html=1;fontFamily=TH SarabunPSK;strokeColor=#000000;fontColor=#000000;rounded=1;arcSize=12;whiteSpace=wrap;fillColor=#FFFFFF;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="35" y="315" width="180" height="114" as="geometry"/></mxCell><mxCell id="mo" value="&lt;b style=&quot;font-size:21px&quot;&gt;อนุมัติพร้อมแก้ไข&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;modified&lt;/span&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000;margin:4px -12px&quot;&gt;&lt;div style=&quot;text-align:left;font-size:18px&quot;&gt;ใช้วัน คาบ หรือห้องที่&lt;br&gt;ฝ่ายวิชาการเลือกแทน&lt;br&gt;แล้วสร้างฉบับเผยแพร่ใหม่&lt;/div&gt;" style="html=1;fontFamily=TH SarabunPSK;strokeColor=#000000;fontColor=#000000;rounded=1;arcSize=12;whiteSpace=wrap;fillColor=#FFFFFF;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="225" y="315" width="180" height="135" as="geometry"/></mxCell><mxCell id="rj" value="&lt;b style=&quot;font-size:21px&quot;&gt;ไม่อนุมัติ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;rejected&lt;/span&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000;margin:4px -12px&quot;&gt;&lt;div style=&quot;text-align:left;font-size:18px&quot;&gt;ตารางสอนเดิม&lt;br&gt;ไม่เปลี่ยนแปลง&lt;/div&gt;" style="html=1;fontFamily=TH SarabunPSK;strokeColor=#000000;fontColor=#000000;rounded=1;arcSize=12;whiteSpace=wrap;fillColor=#FFFFFF;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="415" y="315" width="180" height="114" as="geometry"/></mxCell><mxCell id="cn" value="&lt;b style=&quot;font-size:21px&quot;&gt;ยกเลิก&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;cancelled&lt;/span&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000;margin:4px -12px&quot;&gt;&lt;div style=&quot;text-align:left;font-size:18px&quot;&gt;ตารางสอนเดิม&lt;br&gt;ไม่เปลี่ยนแปลง&lt;/div&gt;" style="html=1;fontFamily=TH SarabunPSK;strokeColor=#000000;fontColor=#000000;rounded=1;arcSize=12;whiteSpace=wrap;fillColor=#FFFFFF;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="605" y="315" width="180" height="114" as="geometry"/></mxCell><mxCell id="fap" value="" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="110" y="485" width="30" height="30" as="geometry"/></mxCell><mxCell id="fmo" value="" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="300" y="485" width="30" height="30" as="geometry"/></mxCell><mxCell id="frj" value="" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="490" y="485" width="30" height="30" as="geometry"/></mxCell><mxCell id="fcn" value="" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="680" y="485" width="30" height="30" as="geometry"/></mxCell><mxCell id="e0" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s" target="pe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l0" value="ครูผู้สอนยื่นคำร้อง (UC-21)" style="text;html=1;fontFamily=TH SarabunPSK;fontSize=18;fontColor=#000000;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="416" y="48" width="167" height="27" as="geometry"/></mxCell><mxCell id="e1" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;exitX=0.055;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pe" target="ap"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l1" value="อนุมัติ" style="text;html=1;fontFamily=TH SarabunPSK;fontSize=18;fontColor=#000000;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="129" y="235" width="38" height="27" as="geometry"/></mxCell><mxCell id="e2" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;exitX=0.352;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pe" target="mo"><mxG