<mxfile host="Claude"><diagram id="state-2-timetable-version" name="สถานะฉบับตารางสอน"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="397" y="11" width="26" height="26" as="geometry"/></mxCell><mxCell id="c" value="" style="html=1;fontFamily=TH SarabunPSK;strokeColor=#000000;fontColor=#000000;rhombus;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="390" y="75" width="40" height="40" as="geometry"/></mxCell><mxCell id="dr" value="&lt;b style=&quot;font-size:21px&quot;&gt;ฉบับร่าง&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;draft · แก้ไขได้&lt;/span&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000;margin:4px -12px&quot;&gt;&lt;div style=&quot;text-align:left;font-size:18px&quot;&gt;จัดตารางสอน 3 วิธี (UC-5 ถึง 7)&lt;br&gt;ตรวจสอบการชนกัน (UC-8)&lt;br&gt;รวมการเปลี่ยนแปลงจากฉบับเผยแพร่&lt;/div&gt;" style="html=1;fontFamily=TH SarabunPSK;strokeColor=#000000;fontColor=#000000;rounded=1;arcSize=12;whiteSpace=wrap;fillColor=#FFFFFF;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="55" y="190" width="330" height="135" as="geometry"/></mxCell><mxCell id="pu" value="&lt;b style=&quot;font-size:21px&quot;&gt;ฉบับเผยแพร่&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;published · แก้ไขไม่ได้&lt;/span&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000;margin:4px -12px&quot;&gt;&lt;div style=&quot;text-align:left;font-size:18px&quot;&gt;ครูดูตารางสอนของตนเอง (UC-10)&lt;br&gt;ครูยื่นคำร้องขอเปลี่ยนการจัด (UC-21)&lt;br&gt;ใช้เป็นคาบสำหรับเช็คชื่อ (UC-23)&lt;br&gt;คัดลอกออกไปเป็นฉบับร่างใหม่ได้&lt;/div&gt;" style="html=1;fontFamily=TH SarabunPSK;strokeColor=#000000;fontColor=#000000;rounded=1;arcSize=12;whiteSpace=wrap;fillColor=#FFFFFF;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="435" y="390" width="330" height="156" as="geometry"/></mxCell><mxCell id="od" value="&lt;b style=&quot;font-size:21px&quot;&gt;ฉบับเก่า&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;old · อ่านอย่างเดียว&lt;/span&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000;margin:4px -12px&quot;&gt;&lt;div style=&quot;text-align:left;font-size:18px&quot;&gt;ดูย้อนหลังได้ แต่ไม่ใช้งาน&lt;/div&gt;" style="html=1;fontFamily=TH SarabunPSK;strokeColor=#000000;fontColor=#000000;rounded=1;arcSize=12;whiteSpace=wrap;fillColor=#FFFFFF;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="435" y="636" width="330" height="93" as="geometry"/></mxCell><mxCell id="e0" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s" target="c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c" target="dr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="220" y="95"/></Array></mxGeometry></mxCell><mxCell id="l1" value="ครูฝ่ายวิชาการสร้างใหม่&lt;br&gt;หรือคัดลอกจากฉบับที่มี&lt;br&gt;(UC-4)" style="text;html=1;fontFamily=TH SarabunPSK;fontSize=18;fontColor=#000000;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="72" y="112" width="144" height="69" as="geometry"/></mxCell><mxCell id="e2" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c" target="pu"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="95"/></Array></mxGeometry></mxCell><mxCell id="l2" value="อนุมัติคำร้อง: ระบบสร้าง&lt;br&gt;ฉบับเผยแพร่ใหม่ทันที&lt;br&gt;(UC-21)" style="text;html=1;fontFamily=TH SarabunPSK;fontSize=18;fontColor=#000000;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="606" y="144" width="152" height="69" as="geometry"/></mxCell><mxCell id="e3" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.0;entryY=0.385;entryDx=0;entryDy=0;" edge="1" parent="1" source="dr" target="pu"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="220" y="450"/></Array></mxGeometry></mxCell><mxCell id="l3" value="เผยแพร่ (UC-9)&lt;br&gt;[ไม่มี Conflict ระดับ error]" style="text;html=1;fontFamily=TH SarabunPSK;fontSize=18;fontColor=#000000;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="224" y="341" width="197" height="48" as="geometry"/></mxCell><mxCell id="e4" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pu" target="od"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l4" value="มีฉบับอื่นเผยแพร่แทน&lt;br&gt;(UC-9, 21)" style="text;html=1;fontFamily=TH SarabunPSK;fontSize=18;fontColor=#000000;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="606" y="566" width="121" height="48" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>