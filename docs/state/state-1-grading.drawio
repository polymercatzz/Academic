okeColor=#000000;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="ap" target="dr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="790" y="720"/><mxPoint x="790" y="348"/></Array></mxGeometry></mxCell><mxCell id="l5" value="อนุมัติ&lt;br&gt;คำขอปลดล็อก&lt;br&gt;(UC-19)" style="text;html=1;fontFamily=TH SarabunPSK;fontSize=18;fontColor=#000000;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="702" y="492" width="84" height="69" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>